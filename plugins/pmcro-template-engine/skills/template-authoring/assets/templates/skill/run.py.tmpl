#!/usr/bin/env python3
"""{{skill}} runner. Standard library only.

Usage:
  run.py --input TEXT     fill assets/example.template.md with TEXT and print it
  run.py --selfcheck      verify the skill's references and assets resolve (exit 0 if intact)
"""
import argparse, sys
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawTextHelpFormatter)
    ap.add_argument("--input")
    ap.add_argument("--selfcheck", action="store_true")
    a = ap.parse_args()
    tpl = HERE / "assets" / "example.template.md"
    if a.selfcheck:
        need = [HERE / "SKILL.md", HERE / "references" / "guide.md", tpl]
        missing = [p.name for p in need if not p.is_file() or p.stat().st_size == 0]
        if missing or "<<INPUT>>" not in tpl.read_text(encoding="utf-8"):
            print("selfcheck FAILED:", missing or "template lacks <<INPUT>> marker", file=sys.stderr)
            return 1
        print("selfcheck ok")
        return 0
    if not a.input:
        ap.error("--input or --selfcheck required")
    print(tpl.read_text(encoding="utf-8").replace("<<INPUT>>", a.input))
    return 0


if __name__ == "__main__":
    sys.exit(main())
