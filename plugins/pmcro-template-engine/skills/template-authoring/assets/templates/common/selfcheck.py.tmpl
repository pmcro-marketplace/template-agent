#!/usr/bin/env python3
"""Run every generated skill's `scripts/run.py --selfcheck`. Exit non-zero if none found or any fails."""
import subprocess, sys
from pathlib import Path

root = Path(__file__).resolve().parent.parent
scripts = sorted(root.glob("**/skills/*/scripts/run.py")) + sorted(root.glob("skills/*/scripts/run.py"))
scripts = sorted(set(scripts))
if not scripts:
    print("no skill run.py found"); sys.exit(1)
bad = 0
for s in scripts:
    r = subprocess.run([sys.executable, str(s), "--selfcheck"], capture_output=True, text=True)
    print(("PASS " if r.returncode == 0 else "FAIL ") + s.relative_to(root).as_posix(), r.stdout.strip(), r.stderr.strip())
    bad += r.returncode != 0
sys.exit(1 if bad else 0)
