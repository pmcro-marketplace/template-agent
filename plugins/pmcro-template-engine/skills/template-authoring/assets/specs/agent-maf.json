{
  "type": "agent-maf",
  "description": "Complete agent project on Microsoft Agent Framework (.NET): runtime project, middleware, smoke test, agent definition, skills, host adapters. Package versions are never guessed; supply MAF_VERSION and OLLAMASHARP_VERSION.",
  "stages": ["foundation", "runtime", "skills", "agents", "integration", "tests"],
  "default_skills": ["core"],
  "defaults": {"TFM": "net9.0", "OLLAMA_ENDPOINT": "http://localhost:11434", "OLLAMA_MODEL": "llama3.2"},
  "entries": [
    {"path": "README.md", "stage": "foundation", "template": "common/README.md.tmpl"},
    {"path": ".gitignore", "stage": "foundation", "template": "common/gitignore.tmpl"},
    {"path": ".pmcro/goal.json", "stage": "foundation", "template": "pmcro/goal.json.tmpl"},
    {"path": ".pmcro/trails/README.md", "stage": "foundation", "template": "pmcro/trails-readme.md.tmpl"},
    {"path": "docs/architecture.md", "stage": "foundation", "template": "maf/architecture.md.tmpl"},
    {"path": "src/{{Name}}.Agent/{{Name}}.Agent.csproj", "stage": "runtime", "template": "maf/Agent.csproj.tmpl"},
    {"path": "src/{{Name}}.Agent/AgentFactory.cs", "stage": "runtime", "template": "maf/AgentFactory.cs.tmpl", "requires": ["src/{{Name}}.Agent/{{Name}}.Agent.csproj"]},
    {"path": "src/{{Name}}.Agent/Middleware/AuditMiddleware.cs", "stage": "runtime", "template": "maf/AuditMiddleware.cs.tmpl"},
    {"path": "src/{{Name}}.Agent/Program.cs", "stage": "runtime", "template": "maf/Program.cs.tmpl", "requires": ["src/{{Name}}.Agent/AgentFactory.cs"]},
    {"path": "src/{{Name}}.Agent/appsettings.json", "stage": "runtime", "template": "maf/appsettings.json.tmpl"},
    {"path": "tests/{{Name}}.Agent.Smoke/{{Name}}.Agent.Smoke.csproj", "stage": "runtime", "template": "maf/Smoke.csproj.tmpl"},
    {"path": "tests/{{Name}}.Agent.Smoke/Program.cs", "stage": "runtime", "template": "maf/SmokeProgram.cs.tmpl"},
    {"path": "skills/{{skill}}/SKILL.md", "stage": "skills", "foreach": "skills", "template": "skill/SKILL.md.tmpl"},
    {"path": "skills/{{skill}}/scripts/run.py", "stage": "skills", "foreach": "skills", "template": "skill/run.py.tmpl"},
    {"path": "skills/{{skill}}/references/guide.md", "stage": "skills", "foreach": "skills", "template": "skill/guide.md.tmpl"},
    {"path": "skills/{{skill}}/assets/example.template.md", "stage": "skills", "foreach": "skills", "template": "skill/example.template.md.tmpl"},
    {"path": "agents/{{name}}.agent.md", "stage": "agents", "template": "agent/agent.md.tmpl", "extra": "single"},
    {"path": "CLAUDE.md", "stage": "integration", "when": {"hosts": "claude-code"}, "template": "host/CLAUDE.md.tmpl"},
    {"path": ".github/copilot-instructions.md", "stage": "integration", "when": {"hosts": "copilot"}, "template": "host/copilot-instructions.md.tmpl"},
    {"path": "AGENTS.md", "stage": "integration", "when": {"hosts": "agents-md"}, "template": "host/AGENTS.md.tmpl"},
    {"path": "tests/selfcheck.py", "stage": "tests", "template": "common/selfcheck.py.tmpl"}
  ],
  "tests": [
    {"id": "skill-selfchecks", "cmd": ["python3", "tests/selfcheck.py"], "cwd": ""},
    {"id": "dotnet-build", "cmd": ["dotnet", "build", "src/{{Name}}.Agent"], "cwd": ""},
    {"id": "dotnet-smoke", "cmd": ["dotnet", "run", "--project", "tests/{{Name}}.Agent.Smoke"], "cwd": ""}
  ]
}
